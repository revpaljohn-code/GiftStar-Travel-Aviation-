rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Connection test endpoint
    match /test/connection {
      allow get: if true;
    }

    // Core primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Zero-read admin email check safe for list queries
    function isAdminEmail() {
      return isEmailVerified() && request.auth.token.email == 'rev.pal.john@gmail.com';
    }

    // Full admin check for single-document & write operations
    function isAdmin() {
      return isAdminEmail() || (
        isEmailVerified() && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Entity validation helpers
    function isValidUserPublic(data, userId) {
      return data.keys().hasAll(['uid', 'displayName', 'role', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'photoURL', 'role', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid == userId && isValidId(data.uid)
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500))
        && data.role is string && data.role in ['traveler', 'admin']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUserPrivate(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'phone', 'homeAirport', 'updatedAt'])
        && data.uid is string && data.uid == userId && isValidId(data.uid)
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 200
        && (!('phone' in data) || (data.phone is string && data.phone.size() <= 40))
        && (!('homeAirport' in data) || (data.homeAirport is string && data.homeAirport.size() <= 60))
        && data.updatedAt is timestamp;
    }

    function isValidBooking(data) {
      return data.keys().hasAll([
          'bookingRef', 'userId', 'customerName', 'customerEmail', 'customerPhone',
          'bookingType', 'itemId', 'itemTitle', 'destination', 'travelDate',
          'guests', 'cabinOrTier', 'totalUsd', 'status', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'bookingRef', 'userId', 'customerName', 'customerEmail', 'customerPhone',
          'bookingType', 'itemId', 'itemTitle', 'destination', 'travelDate', 'returnDate',
          'guests', 'cabinOrTier', 'totalUsd', 'status', 'notes',
          'googleDocId', 'googleDocUrl', 'sheetSynced', 'emailSent',
          'createdAt', 'updatedAt'
        ])
        && data.bookingRef is string && data.bookingRef.size() >= 4 && data.bookingRef.size() <= 32
        && data.bookingRef.matches('^[A-Z0-9\\-]+$')
        && data.userId is string && isValidId(data.userId)
        && data.customerName is string && data.customerName.size() >= 2 && data.customerName.size() <= 120
        && data.customerEmail is string && data.customerEmail.size() >= 3 && data.customerEmail.size() <= 200
        && data.customerPhone is string && data.customerPhone.size() >= 5 && data.customerPhone.size() <= 40
        && data.bookingType is string && data.bookingType in ['package', 'flight', 'hotel', 'custom_itinerary']
        && data.itemId is string && data.itemId.size() >= 1 && data.itemId.size() <= 128
        && data.itemTitle is string && data.itemTitle.size() >= 2 && data.itemTitle.size() <= 160
        && data.destination is string && data.destination.size() >= 2 && data.destination.size() <= 120
        && data.travelDate is string && data.travelDate.size() >= 4 && data.travelDate.size() <= 32
        && (!('returnDate' in data) || (data.returnDate is string && data.returnDate.size() <= 32))
        && data.guests is int && data.guests >= 1 && data.guests <= 50
        && data.cabinOrTier is string && data.cabinOrTier.size() >= 2 && data.cabinOrTier.size() <= 60
        && data.totalUsd is number && data.totalUsd >= 0 && data.totalUsd <= 1000000
        && data.status is string && data.status in ['pending', 'confirmed', 'ticketed', 'cancelled', 'completed']
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 1000))
        && (!('googleDocId' in data) || (data.googleDocId is string && data.googleDocId.size() <= 160))
        && (!('googleDocUrl' in data) || (data.googleDocUrl is string && data.googleDocUrl.size() <= 500))
        && (!('sheetSynced' in data) || data.sheetSynced is bool)
        && (!('emailSent' in data) || data.emailSent is bool)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidReview(data) {
      return data.keys().hasAll(['userId', 'authorName', 'routeOrPackage', 'rating', 'comment', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['userId', 'authorName', 'authorRole', 'routeOrPackage', 'rating', 'comment', 'status', 'createdAt', 'updatedAt'])
        && data.userId is string && isValidId(data.userId)
        && data.authorName is string && data.authorName.size() >= 2 && data.authorName.size() <= 100
        && (!('authorRole' in data) || (data.authorRole is string && data.authorRole.size() <= 100))
        && data.routeOrPackage is string && data.routeOrPackage.size() >= 2 && data.routeOrPackage.size() <= 140
        && data.rating is int && data.rating >= 1 && data.rating <= 5
        && data.comment is string && data.comment.size() >= 10 && data.comment.size() <= 1200
        && data.status is string && data.status in ['published', 'hidden']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPackage(data) {
      return data.keys().hasAll(['title', 'destination', 'region', 'durationDays', 'priceUsd', 'tier', 'summary', 'highlights', 'active', 'createdBy', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['title', 'destination', 'region', 'durationDays', 'priceUsd', 'tier', 'summary', 'highlights', 'active', 'createdBy', 'createdAt', 'updatedAt'])
        && data.title is string && data.title.size() >= 3 && data.title.size() <= 140
        && data.destination is string && data.destination.size() >= 2 && data.destination.size() <= 100
        && data.region is string && data.region.size() >= 2 && data.region.size() <= 80
        && data.durationDays is int && data.durationDays >= 1 && data.durationDays <= 90
        && data.priceUsd is number && data.priceUsd >= 0 && data.priceUsd <= 500000
        && data.tier is string && data.tier in ['Signature', 'Executive', 'Bespoke']
        && data.summary is string && data.summary.size() >= 10 && data.summary.size() <= 600
        && data.highlights is list && data.highlights.size() >= 1 && data.highlights.size() <= 10 && data.highlights[0] is string
        && data.active is bool
        && data.createdBy is string && isValidId(data.createdBy)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Users collection (public non-PII)
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdminEmail();
      allow create: if isEmailVerified()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUserPublic(incoming(), userId)
        && incoming().role == 'traveler'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isEmailVerified()
        && isValidId(userId)
        && isValidUserPublic(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() || (
            isOwner(userId)
            && incoming().role == existing().role
            && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'updatedAt'])
          )
        );
      allow delete: if isAdmin() && isValidId(userId);

      // Isolated PII subcollection
      match /private/{docId} {
        allow get: if isValidId(userId) && isValidId(docId) && (isOwner(userId) || isAdmin());
        allow list: if false;
        allow create: if isEmailVerified()
          && isValidId(userId)
          && isValidId(docId)
          && docId == 'info'
          && isOwner(userId)
          && isValidUserPrivate(incoming(), userId)
          && incoming().updatedAt == request.time;
        allow update: if isEmailVerified()
          && isValidId(userId)
          && isValidId(docId)
          && docId == 'info'
          && isOwner(userId)
          && isValidUserPrivate(incoming(), userId)
          && incoming().uid == existing().uid
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['email', 'phone', 'homeAirport', 'updatedAt']);
        allow delete: if isAdmin() && isValidId(userId) && isValidId(docId);
      }
    }

    // Admins registry (read-only for owner check)
    match /admins/{adminId} {
      allow get: if isValidId(adminId) && (isOwner(adminId) || isAdmin());
      allow list: if isAdminEmail();
      allow create, update, delete: if false;
    }

    // Bookings collection
    match /bookings/{bookingId} {
      allow get: if isValidId(bookingId) && (isOwner(existing().userId) || isAdmin());
      allow list: if isSignedIn() && (existing().userId == request.auth.uid || isAdminEmail());
      allow create: if isEmailVerified()
        && isValidId(bookingId)
        && isValidBooking(incoming())
        && incoming().userId == request.auth.uid
        && incoming().status == 'pending'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isEmailVerified()
        && isValidId(bookingId)
        && isValidBooking(incoming())
        && incoming().userId == existing().userId
        && incoming().bookingRef == existing().bookingRef
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() || (
            isOwner(existing().userId)
            && !(existing().status in ['completed', 'cancelled'])
            && (
              (
                incoming().status == 'cancelled'
                && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
              ) || (
                incoming().status == existing().status
                && incoming().diff(existing()).affectedKeys().hasOnly(['googleDocId', 'googleDocUrl', 'sheetSynced', 'emailSent', 'notes', 'updatedAt'])
              )
            )
          )
        );
      allow delete: if isAdmin() && isValidId(bookingId);
    }

    // Reviews collection
    match /reviews/{reviewId} {
      allow get: if isValidId(reviewId) && (existing().status == 'published' || isOwner(existing().userId) || isAdmin());
      allow list: if existing().status == 'published' || (isSignedIn() && existing().userId == request.auth.uid) || isAdminEmail();
      allow create: if isEmailVerified()
        && isValidId(reviewId)
        && isValidReview(incoming())
        && incoming().userId == request.auth.uid
        && incoming().status == 'published'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isEmailVerified()
        && isValidId(reviewId)
        && isValidReview(incoming())
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() || (
            isOwner(existing().userId)
            && incoming().status == existing().status
            && incoming().diff(existing()).affectedKeys().hasOnly(['rating', 'comment', 'routeOrPackage', 'authorRole', 'updatedAt'])
          )
        );
      allow delete: if isValidId(reviewId) && (isOwner(existing().userId) || isAdmin());
    }

    // Admin-curated packages collection
    match /packages/{packageId} {
      allow get: if isValidId(packageId) && (existing().active == true || isAdmin());
      allow list: if existing().active == true || isAdminEmail();
      allow create: if isAdmin()
        && isValidId(packageId)
        && isValidPackage(incoming())
        && incoming().createdBy == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isAdmin()
        && isValidId(packageId)
        && isValidPackage(incoming())
        && incoming().createdBy == existing().createdBy
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;
      allow delete: if isAdmin() && isValidId(packageId);
    }
  }
}
